<Window x:Class="TarkovTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SayserTarkovTracker"
        Icon="app.ico"
        Height="900"
        Width="1440"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TacticalBgDarkBrush}"
        FontFamily="{StaticResource TacticalFont}">

    <DockPanel LastChildFill="True">

        <!-- Top command bar -->
        <Border DockPanel.Dock="Top"
                Background="#121610"
                BorderBrush="{StaticResource TacticalAmberDimBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            BorderBrush="{StaticResource TacticalAmberBrush}"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <Grid>
                            <Line X1="14" Y1="4" X2="14" Y2="24" Stroke="{StaticResource TacticalAmberBrush}" StrokeThickness="1"/>
                            <Line X1="4" Y1="14" X2="24" Y2="14" Stroke="{StaticResource TacticalAmberBrush}" StrokeThickness="1"/>
                            <Ellipse Width="6" Height="6" Stroke="{StaticResource TacticalAmberBrush}" StrokeThickness="1"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SAYSERTARKOVTRACKER"
                                   Foreground="{StaticResource TacticalTextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="AppVersionSubtitleText"
                                   Text="TACTICAL MAP INTERFACE"
                                   Foreground="{StaticResource TacticalTextMutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="MAP SELECT"
                               Style="{StaticResource TacticalLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="MapComboBox"
                              Style="{StaticResource TacticalComboBox}"
                              Width="200"
                              SelectionChanged="MapComboBox_SelectionChanged"/>
                    <CheckBox x:Name="MapRotationCheckBox"
                              Style="{StaticResource TacticalSettingsCheckBox}"
                              VerticalAlignment="Center"
                              Content="180° ROTATE"
                              Margin="12,0,0,0"
                              Checked="MapRotationCheckBox_Changed"
                              Unchecked="MapRotationCheckBox_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="SETTINGS"
                            Style="{StaticResource TacticalButton}"
                            Click="OpenSettings_Click"/>
                    <Button Content="READ LATEST SCREENSHOT"
                            Style="{StaticResource TacticalButton}"
                            Click="ReadLatestScreenshot_Click"/>
                    <Button Content="RESET VIEW"
                            Style="{StaticResource TacticalButton}"
                            Click="ResetView_Click"/>
                    <Button Content="OVERLAY"
                            Style="{StaticResource TacticalButton}"
                            Margin="0"
                            Click="OpenOverlayButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="#0A0C08"
                BorderBrush="{StaticResource TacticalAmberDimBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&gt; _"
                               FontFamily="{StaticResource TacticalMonoFont}"
                               Foreground="{StaticResource TacticalTerminalGreenBrush}"
                               FontSize="13"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="ParserStatusText"
                               Text="PARSER: WAITING"
                               FontFamily="{StaticResource TacticalMonoFont}"
                               Foreground="{StaticResource TacticalTerminalGreenBrush}"
                               FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DATA SOURCE: SCREENSHOT"
                               Style="{StaticResource TacticalLabel}"
                               Margin="0,0,16,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="READY"
                               Style="{StaticResource TacticalLabel}"
                               Foreground="{StaticResource TacticalTextPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Background="{StaticResource TacticalBgDarkBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Map viewport -->
            <Border Grid.Column="0" Style="{StaticResource TacticalMapFrame}">
                <Border Background="{StaticResource TacticalBgInsetBrush}"
                        BorderBrush="{StaticResource TacticalAmberDimBrush}"
                        BorderThickness="1">
                    <wv2:WebView2 x:Name="MapWebView"/>
                </Border>
            </Border>

            <!-- Right sidebar -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,10,10,10">
                <StackPanel Margin="0,0,4,0">

                    <!-- Screenshot data -->
                    <Border Style="{StaticResource TacticalPanel}">
                        <StackPanel>
                            <TextBlock Text="SCREENSHOT DATA" Style="{StaticResource TacticalSectionHeader}"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Grid.Row="0">
                                    <TextBlock Text="COORD X" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource TacticalLcdBox}">
                                        <TextBlock x:Name="GameXText" Text="-" Style="{StaticResource TacticalValue}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="0">
                                    <TextBlock Text="COORD Y" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource TacticalLcdBox}">
                                        <TextBlock x:Name="GameYText" Text="-" Style="{StaticResource TacticalValue}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="2">
                                    <TextBlock Text="ELEV Z" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource TacticalLcdBox}">
                                        <TextBlock x:Name="GameZText" Text="-" Style="{StaticResource TacticalValue}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="2">
                                    <TextBlock Text="BEARING" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource TacticalLcdBox}">
                                        <TextBlock x:Name="DirectionText" Text="-" Style="{StaticResource TacticalValue}" FontSize="18"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="ACTIVE MAP" Style="{StaticResource TacticalLabel}" Margin="0,4,0,4"/>
                            <TextBlock x:Name="CurrentMapText"
                                       Text="NONE"
                                       Foreground="{StaticResource TacticalAmberBrightBrush}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="DETECTED RES" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetectedResolutionText"
                                       Text="—"
                                       FontFamily="{StaticResource TacticalMonoFont}"
                                       Foreground="{StaticResource TacticalTextPrimaryBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="CAPTURED" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LastScreenshotText"
                                       Text="NONE"
                                       FontFamily="{StaticResource TacticalMonoFont}"
                                       Foreground="{StaticResource TacticalTextPrimaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Raid exfil highlights -->
                    <Border Style="{StaticResource TacticalPanel}">
                        <StackPanel>
                            <TextBlock Text="RAID EXFILS" Style="{StaticResource TacticalSectionHeader}"/>
                            <TextBlock x:Name="RaidExfilStatusText"
                                       Text="NONE DETECTED"
                                       Foreground="{StaticResource TacticalTextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="EXFILS" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RaidExfilExtractsText"
                                       Text="—"
                                       FontFamily="{StaticResource TacticalMonoFont}"
                                       Foreground="{StaticResource TacticalTerminalGreenBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="TRANSITS" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RaidExfilTransitsText"
                                       Text="—"
                                       FontFamily="{StaticResource TacticalMonoFont}"
                                       Foreground="{StaticResource TacticalAmberBrightBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Selected marker -->
                    <Border Style="{StaticResource TacticalPanel}">
                        <StackPanel>
                            <TextBlock Text="SELECTED MARKER" Style="{StaticResource TacticalSectionHeader}"/>
                            <TextBlock x:Name="SelectedMarkerNameText"
                                       Text="NONE"
                                       Foreground="{StaticResource TacticalAmberBrightBrush}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="SelectedMarkerDetailsText"
                                       Text="Click a marker on the map."
                                       Style="{StaticResource TacticalBody}"
                                       FontSize="11"
                                       Foreground="{StaticResource TacticalTextMutedBrush}"
                                       Margin="0,0,0,8"/>
                            <StackPanel x:Name="QuestLinkPanel" Visibility="Collapsed">
                                <Button x:Name="OpenQuestTarkovDevButton"
                                        Content="OPEN ON TARKOV.DEV"
                                        Style="{StaticResource TacticalSmallButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,4"
                                        Click="OpenQuestTarkovDevButton_Click"/>
                                <Button x:Name="OpenQuestWikiButton"
                                        Content="OPEN ON WIKI"
                                        Style="{StaticResource TacticalSmallButton}"
                                        HorizontalAlignment="Left"
                                        Click="OpenQuestWikiButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Search & quest filters -->
                    <Border Style="{StaticResource TacticalPanel}">
                        <StackPanel>
                            <TextBlock Text="SEARCH &amp; FILTERS" Style="{StaticResource TacticalSectionHeader}"/>

                            <TextBlock Text="MARKER SEARCH" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="MarkerSearchTextBox"
                                     Style="{StaticResource TacticalTextBox}"
                                     Margin="0,0,0,4"
                                     TextChanged="MarkerSearchTextBox_TextChanged"/>
                            <TextBlock Text="Comma-separated terms (e.g. sniper, therapist, dorms)"
                                       Style="{StaticResource TacticalBody}"
                                       FontSize="10"
                                       Foreground="{StaticResource TacticalTextMutedBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="QUEST NAME" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="QuestNameFilterComboBox"
                                    Style="{StaticResource TacticalComboBox}"
                                    Tag="All Quests"
                                    Margin="0,0,0,8"
                                    HorizontalContentAlignment="Stretch">
                                
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid SnapsToDevicePixels="True">
                                            <!-- Dropdown Header ToggleButton using the resource style -->
                                            <ToggleButton Style="{StaticResource TacticalToggleButton}"
                                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                        ClickMode="Press">
                                                <TextBlock Text="{TemplateBinding Tag}"
                                                        Foreground="{StaticResource TacticalAmberBrightBrush}"
                                                        FontFamily="{StaticResource TacticalFont}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center" />
                                            </ToggleButton>

                                            <!-- WPF Internal Popup Engine -->
                                            <Popup x:Name="PART_Popup"
                                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                                Placement="Bottom"
                                                AllowsTransparency="True"
                                                Focusable="False"
                                                PopupAnimation="Slide">
                                                <Border Background="#121212"
                                                        BorderBrush="{StaticResource TacticalAmberBrush}"
                                                        BorderThickness="1"
                                                        MaxHeight="300"
                                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ScrollViewer>
                                                        <ItemsPresenter x:Name="ItemsPresenter" />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </ComboBox.Template>

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                Style="{StaticResource TacticalComboBoxCheckbox}"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Checked="QuestFilter_Changed"
                                                Unchecked="QuestFilter_Changed"
                                                Margin="4,2"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="TRADER" Style="{StaticResource TacticalLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="QuestTraderFilterComboBox"
                                      Style="{StaticResource TacticalComboBox}"
                                      IsEditable="True"
                                      IsReadOnly="True"
                                      Margin="0,0,0,8"
                                      SelectionChanged="QuestFilter_Changed"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="CLEAR FILTERS"
                                        Style="{StaticResource TacticalSmallButton}"
                                        HorizontalAlignment="Left"
                                        Click="ClearSearchFilters_Click"/>
                                <CheckBox x:Name="ShowQuestNamesCheckBox"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"                                          
                                          Style="{StaticResource TacticalSettingsCheckBox}"
                                          Content="Show Quest Names"
                                          Checked="ShowQuestNamesCheckBox_Changed"
                                          Unchecked="ShowQuestNamesCheckBox_Changed"/>                                        
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Markers grid -->
                    <Border Style="{StaticResource TacticalPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="MARKERS" Style="{StaticResource TacticalSectionHeader}" Margin="0"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                    <Button Content="SHOW ALL"
                                            Style="{StaticResource TacticalSmallButton}"
                                            Margin="0,0,6,0"
                                            Click="ShowAllMarkers_Click"/>
                                    <Button Content="HIDE ALL"
                                            Style="{StaticResource TacticalSmallButton}"
                                            Margin="0"
                                            Click="HideAllMarkers_Click"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="SaveMarkerFiltersCheckBox"
                                      Style="{StaticResource TacticalSettingsCheckBox}"
                                      Content="Save marker selection between sessions"
                                      Margin="0,0,0,10"
                                      Checked="SaveMarkerFilters_Changed"
                                      Unchecked="SaveMarkerFilters_Changed"/>

                            <UniformGrid Columns="4" Rows="6">

                                <CheckBox x:Name="ShowLabelsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="True"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <TextBlock Text="Location Names"
                                               FontSize="9"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,10,0,0"/>
                                </CheckBox>

                                <CheckBox x:Name="ShowQuestItemsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/quest_item.png"/>
                                        <TextBlock Text="Quest Item" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowQuestObjectivesCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/quest_objective.png"/>
                                        <TextBlock Text="Quest Obj" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowPmcExtractsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="True"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/extract_pmc.png"/>
                                        <TextBlock Text="PMC Ext" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowScavExtractsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="True"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/extract_scav.png"/>
                                        <TextBlock Text="Scav Ext" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowSharedExtractsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="True"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/extract_shared.png"/>
                                        <TextBlock Text="Shared" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowTransitsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="True"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/extract_transit.png"/>
                                        <TextBlock Text="Transit" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowHazardsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="True"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/hazard.png"/>
                                        <TextBlock Text="Hazard" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowHazardZonesCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="True"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="24" Height="24">
                                            <Polygon Points="12,2 22,12 12,22 2,12"
                                                     Fill="#44FF5722"
                                                     Stroke="#FF5722"
                                                     StrokeThickness="2"/>
                                        </Viewbox>
                                        <TextBlock Text="Hazard Zone" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowSwitchesCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="True"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/switch.png"/>
                                        <TextBlock Text="Switch" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowValuablesCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="22" Height="22" Margin="0,2,0,0">
                                            <Canvas Width="24" Height="24">
                                                <Polygon Points="4.5,16.2 8,13.2 16,13.2 19.5,16.2 16,19.3 8,19.3"
                                                         Fill="#D4A017" Stroke="#7A5A12" StrokeThickness="1.1" StrokeLineJoin="Round"/>
                                                <Polygon Points="4.5,11.2 8,8.2 16,8.2 19.5,11.2 16,14.3 8,14.3"
                                                         Fill="#F0C94A" Stroke="#7A5A12" StrokeThickness="1.1" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Valuables" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowBattlePassDocumentsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="22" Margin="0,2,0,0">
                                            <Grid>
                                                <Rectangle Width="14" Height="18" Fill="#F3EAD2" Stroke="#8A7348" StrokeThickness="1.2" RadiusX="1" RadiusY="1"/>
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Text="BP Docs" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowSafesCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/container_safe.png"/>
                                        <TextBlock Text="Safe" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowGroundCachesCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/container_ground-cache.png"/>
                                        <TextBlock Text="Ground Cache" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowLocksCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/lock.png"/>
                                        <TextBlock Text="Locks" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowPmcSpawnsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/spawn_pmc.png"/>
                                        <TextBlock Text="PMC Spawn" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowScavSpawnsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/spawn_scav.png"/>
                                        <TextBlock Text="Scav Spawn" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowBossSpawnsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/spawn_boss.png"/>
                                        <TextBlock Text="Boss" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowCultistSpawnsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          Visibility="Collapsed"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/spawn_cultist-priest.png"/>
                                        <TextBlock Text="Cultist" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowBtrStopsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          Visibility="Collapsed"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Width="24" Height="24"
                                               Source="pack://siteoforigin:,,,/Maps/interactive/btr_stop.png"/>
                                        <TextBlock Text="BTR Stops" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="ShowCustomPinsCheckBox"
                                          Style="{StaticResource TacticalMarkerTile}"
                                          IsChecked="False"
                                          Checked="MarkerFilter_Changed"
                                          Unchecked="MarkerFilter_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" Margin="0,2,0,0">
                                            <Polygon Points="12,2 22,12 12,22 2,12"
                                                     Fill="#FFB300"
                                                     Stroke="#FFF3E0"
                                                     StrokeThickness="1.5"/>
                                        </Viewbox>
                                        <TextBlock Text="Custom Pin" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Levels -->
                    <Border Style="{StaticResource TacticalPanel}" Margin="0">
                        <StackPanel>
                            <Grid x:Name="LevelsHeaderGrid" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="LEVELS"
                                           Style="{StaticResource TacticalSectionHeader}"
                                           VerticalAlignment="Center"
                                           Margin="0"/>

                                <Button Grid.Column="1"
                                        Content="ALL"
                                        Style="{StaticResource TacticalSmallButton}"
                                        Width="40"
                                        Margin="0,0,6,0"
                                        Click="ShowAllLayers_Click"/>

                                <Button Grid.Column="2"
                                        Content="NONE"
                                        Style="{StaticResource TacticalSmallButton}"
                                        Width="48"
                                        Click="HideAllLayers_Click"/>
                            </Grid>

                            <WrapPanel x:Name="LayersPanel"/>

                            <CheckBox x:Name="AutoSelectFloorCheckBox"
                                      Style="{StaticResource TacticalSettingsCheckBox}"
                                      Content="Auto-select floor from player height (Y)"
                                      Margin="0,10,0,0"
                                      Checked="AutoSelectFloorCheckBox_Changed"
                                      Unchecked="AutoSelectFloorCheckBox_Changed"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</Window>
